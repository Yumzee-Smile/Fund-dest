# Fund Desk app configuration. Every variable the app reads, with safe defaults.
# Nothing is sent to a network unless a command gets --submit AND SOROBAN_RPC_URL answers.

# Soroban RPC endpoint and network (testnet shown; the build environment could not reach it).
SOROBAN_RPC_URL=
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Contract ids (C...) written by scripts/deploy-testnet.sh. Empty = offline placeholders.
FD_OPS_ID=
FD_ORACLE_ID=
FD_COMPLIANCE_ID=
FD_DISTRIBUTION_ID=
FD_VAULT_ID=
FD_SHARE_ID=
FD_CASH_ID=

# Role keys (S... secrets) for the ops_account signers and the treasury. Never commit real ones.
FD_TA_SECRET_1=
FD_TA_SECRET_2=
FD_ADMIN_SECRET=
FD_TREASURY_SECRET=

# Local event journal (RPC keeps events for about 7 days).
FD_JOURNAL=funddesk-journal.json

# Optional model provider for KYC triage / form extraction. Unset = deterministic heuristic.
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
